# pixi environments
.pixi/*
!.pixi/config.toml
build/
spikes/out/
spikes/epoll_echo/tokio_echo/target/
# Spike outputs: binaries and cargo target dirs are rebuilt by
# spikes/epoll_echo/run.sh; only the saved result JSONs (cited by
# docs/spikes.md) are kept.
spikes/epoll_echo/out/*
!spikes/epoll_echo/out/*.json
